# ─────────────────────────────────────────────────────────────────────────────
# Voyagr backend environment.
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Spring Boot reads it via `spring.config.import=optional:file:./.env[.properties]`.
# Never commit your `.env`. Never put secrets in `frontend/.env`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (matches docker-compose.yml in the repo root) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/voyagr
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- JWT ---
# Generate with:  openssl rand -base64 48
# Must be at least 32 bytes after base64 decoding (HS256 minimum).
JWT_SECRET=

# --- AI / external APIs ---
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
OPENWEATHERMAP_API_KEY=
SKYSCANNER_API_KEY=

# --- CORS (comma-separated) ---
VOYAGR_CORS_ALLOWED_ORIGINS=http://localhost:5173
